{
  "name": "@sideboard-ai/core",
  "version": "0.1.155",
  "description": "Sideboard core — orchestration, agents, git worktrees, MCP server",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sideboard-mcp": "./dist/mcp/run-stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/agents/cursor-runner.ts --format esm,cjs --dts --clean && tsup --config tsup.mcp.config.ts && node scripts/add-bin-shebang.cjs",
    "dev": "tsup src/index.ts src/agents/cursor-runner.ts src/mcp/run-stdio.ts --format esm,cjs --dts --watch",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mattlevine/sideboard.git",
    "directory": "packages/core"
  },
  "keywords": [
    "sideboard",
    "mcp",
    "model-context-protocol",
    "agents",
    "worktree"
  ],
  "dependencies": {
    "@cursor/sdk": "^1.0.28",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.9.1",
    "chokidar": "^4.0.3",
    "croner": "^10.0.1",
    "execa": "^9.5.2",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "^1.3.1",
    "ws": "^8.21.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.18.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
