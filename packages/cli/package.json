{
  "name": "@sideboard-ai/cli",
  "version": "0.1.138",
  "description": "Sideboard CLI — agent-agnostic worktree orchestration (includes `sideboard mcp`)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "sideboard": "./dist/index.js",
    "side": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@sideboard-ai/core": "workspace:*",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mattlevine/sideboard.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "sideboard",
    "cli",
    "mcp",
    "agents",
    "worktree"
  ]
}
