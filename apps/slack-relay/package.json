{
  "name": "@sideboard-ai/slack-relay",
  "version": "0.1.70",
  "private": true,
  "description": "Hosted Slack inbound relay for the official Sideboard Slack app",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
