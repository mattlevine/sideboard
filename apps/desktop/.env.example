# Copy to apps/desktop/.env for signed Mac releases (`pnpm release`).
# Same Developer ID credentials as Brightsy desktop are fine.

# Exported Developer ID Application .p12 (base64) + password
CSC_LINK=
CSC_KEY_PASSWORD=

# Apple notarization (app-specific password from appleid.apple.com)
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# GitHub Releases publish (optional if `gh auth login` is available)
GH_TOKEN=

# npm publish for @sideboard-ai/cli + @sideboard-ai/core (optional if `npm login` is available)
NPM_TOKEN=
