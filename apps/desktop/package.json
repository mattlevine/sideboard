{
  "name": "@sideboard-ai/desktop",
  "version": "0.1.136",
  "private": true,
  "description": "Sideboard desktop — agent-agnostic worktree orchestration",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE -u ELECTRON_RENDERER_URL -u ELECTRON_NO_ASAR -u ELECTRON_FORCE_IS_PACKAGED -u CHROME_CRASHPAD_PIPE_NAME electron-vite dev",
    "predev": "pnpm -w --filter @sideboard-ai/core build",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "postinstall": "electron-rebuild -f -w better-sqlite3,node-pty || true",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3,node-pty",
    "dist": "pnpm run build && node scripts/stage-bundled-node.js && node scripts/stage-sideboard-mcp.js && node scripts/stage-cursor-runtime.js && electron-builder --mac",
    "dist:dir": "pnpm run build && node scripts/stage-bundled-node.js && node scripts/stage-sideboard-mcp.js && node scripts/stage-cursor-runtime.js && electron-builder --mac --dir",
    "dist:mac": "node scripts/release.js patch mac never",
    "pack": "pnpm run dist:dir",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@brightsy/client": "^1.0.26",
    "@monaco-editor/react": "^4.7.0",
    "@sideboard-ai/core": "workspace:*",
    "@tiptap/extension-color": "^3.8.0",
    "@tiptap/extension-image": "^3.8.0",
    "@tiptap/extension-link": "^3.8.0",
    "@tiptap/extension-placeholder": "^3.8.0",
    "@tiptap/extension-table": "^3.8.0",
    "@tiptap/extension-table-cell": "^3.8.0",
    "@tiptap/extension-table-header": "^3.8.0",
    "@tiptap/extension-table-row": "^3.8.0",
    "@tiptap/extension-text-align": "^3.8.0",
    "@tiptap/extension-text-style": "^3.8.0",
    "@tiptap/extension-underline": "^3.8.0",
    "@tiptap/pm": "^3.8.0",
    "@tiptap/react": "^3.8.0",
    "@tiptap/starter-kit": "^3.8.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^11.9.1",
    "chokidar": "^4.0.3",
    "electron-updater": "^6.3.9",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.4.0",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.9"
  },
  "build": {
    "appId": "ai.sideboard.app",
    "productName": "Sideboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/node",
        "to": "node"
      },
      {
        "from": "build/cursor-runtime",
        "to": "cursor-runtime"
      },
      {
        "from": "build/sideboard-mcp",
        "to": "sideboard-mcp"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mattlevine",
        "repo": "sideboard",
        "releaseType": "release"
      }
    ]
  }
}
