{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["vite/client"],
    "paths": {
      "@sideboard/message-parts": ["../../packages/core/src/agents/message-parts.ts"],
      "@sideboard/worktree-labels": ["../../packages/core/src/git/worktree-labels.ts"],
      "@sideboard/brightsy-targets": ["../../packages/core/src/agents/brightsy-targets.ts"],
      "@sideboard/gh-errors": ["../../packages/core/src/git/gh-errors.ts"],
      "@sideboard/orchestrator-capable": ["../../packages/core/src/agents/orchestrator-capable.ts"],
      "@brightsy/ui-context": ["./node_modules/@brightsy/ui/src/context/UIComponentsContext.tsx"]
    }
  },
  "include": ["src/renderer/src/**/*", "src/preload/index.d.ts"]
}
