{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["vite/client"],
    "paths": {
      "@sideboard/message-parts": ["../../packages/core/src/agents/message-parts.ts"],
      "@sideboard/usage": ["../../packages/core/src/agents/usage.ts"],
      "@sideboard/worktree-labels": ["../../packages/core/src/git/worktree-labels.ts"],
      "@sideboard/brightsy-targets": ["../../packages/core/src/agents/brightsy-targets.ts"],
      "@sideboard/gh-errors": ["../../packages/core/src/git/gh-errors.ts"],
      "@sideboard/diff-comment": ["../../packages/core/src/composer/diff-comment.ts"],
      "@sideboard/teams": ["../../packages/core/src/git/teams.ts"],
      "@sideboard/orchestrator-capable": ["../../packages/core/src/agents/orchestrator-capable.ts"],
      "@sideboard/plan-ask-user": ["../../packages/core/src/plan/ask-user.ts"],
      "@sideboard/plan-file": ["../../packages/core/src/plan/plan-present.ts"],
      "@sideboard/agent-git-actions": ["../../packages/core/src/git/agent-git-actions.ts"],
      "@sideboard/review-request-template": ["../../packages/core/src/review/review-request-template.ts"],
      "@sideboard/issue-source-labels": ["../../packages/core/src/store/issue-source-labels.ts"],
      "@sideboard/home-board": ["../../packages/core/src/board/home-board.ts"],
      "@brightsy/ui-context": ["./node_modules/@brightsy/ui/src/context/UIComponentsContext.tsx"]
    }
  },
  "include": ["src/renderer/src/**/*", "src/preload/index.d.ts"]
}
